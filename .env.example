# Copy to .env and customize.

# Pipeline / versioning
RAG_RAW_PDF_DIR=data/raw/pdfs
RAG_WORKSPACE=default
RAG_GIT_COMMIT=local
RAG_DOCKER_IMAGE_TAG=local
RAG_ACTIVE_ARTIFACT_RUN_ID=

# Chunking
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=32

# Embedding model cache/runtime
# First run can download the SentenceTransformer model into this mounted cache.
# Later runs can set RAG_EMBEDDING_OFFLINE=true to avoid Hugging Face network calls.
RAG_EMBEDDING_CACHE_DIR=/models/sentence-transformers
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_OFFLINE=false

# Retrieval
RAG_TOP_K_BM25=50
RAG_TOP_K_DENSE=50
RAG_TOP_K_FINAL=10
RAG_RRF_K=60
RAG_PRIMARY_METRIC=mrr
RAG_MIN_EVAL_MRR=0.05

# Guardrails
RAG_MIN_RETRIEVAL_SCORE=0.05
RAG_MIN_COVERAGE_RATIO=0.15
RAG_MIN_OVERLAP_FOR_GROUNDING=0.20

# LLM
# Default = stub, suitable for CI/offline smoke tests.
# Set RAG_LLM_PROVIDER=ollama for local GPU generation.
RAG_LLM_PROVIDER=stub
RAG_LLM_MODEL=lokeshjothiram/rag-distiller-v1:4b
RAG_OLLAMA_HOST=http://host.docker.internal:11434
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_TOP_P=0.9
RAG_LLM_MAX_TOKENS=512

# Optional cloud LLMs
# RAG_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# RAG_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# API
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000
