name: CT - Continuous Training

on:
  workflow_dispatch:
    inputs:
      pdf_dir:
        description: "Local PDF directory to ingest"
        required: false
        default: "data/raw/pdfs"
      max_queries:
        description: "Limit eval questions"
        required: false
        default: "50"
  push:
    paths:
      # Corpus/config changes trigger full downstream rebuild.
      - "data/raw/**"
      - "data/evaluation/**"
      - "src/ingestion/**"
      - "src/chunking/**"
      - "src/indexing/**"
      - "src/retrieval/**"
      - "src/evaluation/**"
      - "src/core/registry.py"
      - "src/core/config.py"

jobs:
  retrain:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install
        run: |
          pip install --upgrade pip
          pip install -r requirements.txt

      - name: Cache HuggingFace models
        uses: actions/cache@v4
        with:
          path: ~/.cache/huggingface
          key: hf-${{ hashFiles('src/core/registry.py') }}

      - name: Run local corpus CT pipeline
        env:
          RAG_GIT_COMMIT: ${{ github.sha }}
          RAG_DOCKER_IMAGE_TAG: ghcr.io/${{ github.repository }}:${{ github.sha }}
        run: |
          python -m src.cli run-full \
            --source pdf \
            --pdf-dir "${{ github.event.inputs.pdf_dir || 'data/raw/pdfs' }}" \
            --max-queries "${{ github.event.inputs.max_queries || '50' }}"

      - name: Quality gate
        run: |
          python - <<'PY'
          import json, sys
          rec = json.load(open('outputs/best_model.json'))
          mrr = rec['metrics'].get('mrr', 0.0)
          print(f'Best={rec["best_model"]} MRR={mrr:.4f}')
          sys.exit(0 if mrr >= 0.05 else 1)
          PY

      - name: Upload versioned artefacts
        uses: actions/upload-artifact@v4
        with:
          name: pipeline-artefacts-${{ github.sha }}
          path: |
            artifacts/runs/**
            outputs/best_model.json
            outputs/eval/benchmark.json
            outputs/eval/evaluation_report.json
            outputs/eval/evaluation_report.md

      - name: Commit evaluation outputs
        if: github.event_name == 'workflow_dispatch'
        run: |
          git config user.name "ct-bot"
          git config user.email "ct-bot@users.noreply.github.com"
          git add outputs/best_model.json outputs/eval/ artifacts/runs/ || true
          git commit -m "ct: update retrieval artefacts and evaluation report [skip ci]" || echo "no changes"
          git push || echo "no remote push (likely fork)"
